<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state: luminous Apple TV pure white pill -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#F8FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Selected state: translucent glass with active white border -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#35FFFFFF" />
            <stroke android:width="1.5dp" android:color="#A0FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Default state: sleek frosted glass card with hairline border -->
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#22FFFFFF" android:endColor="#10FFFFFF" />
            <stroke android:width="1dp" android:color="#26FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
